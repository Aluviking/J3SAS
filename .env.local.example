# Copia este archivo a .env.local (no se sube a git) y pon tus claves reales.
# Se obtienen gratis en https://console.groq.com/keys
# Ponles un límite de gasto de $0 en Groq: quedan visibles en el navegador
# (se llaman directo desde el cliente, sin backend), así que si alguien las
# copia no puede generarte ningún cobro.
NEXT_PUBLIC_GROQ_API_KEY=
# Claves de respaldo (opcionales): si una se queda sin cupo del minuto,
# Celeste cambia automáticamente a la siguiente para no dejar de responder.
NEXT_PUBLIC_GROQ_API_KEY_2=
NEXT_PUBLIC_GROQ_API_KEY_3=
